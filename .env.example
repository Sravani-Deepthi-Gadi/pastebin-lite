# Postgres connection string (Neon, Supabase, RDS, local Postgres, ...).
# Neon gives you one that already ends in ?sslmode=require
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Set to 1 to allow the x-test-now-ms request header to override the clock
# used for expiry logic. Required by the automated grader.
TEST_MODE=1

# Optional. Absolute base URL used when building the shareable paste URL.
# Leave unset to derive it from the incoming request (works on Vercel).
# PUBLIC_BASE_URL=https://your-app.vercel.app

# Local development only: run against an embedded WASM Postgres instead of
# a real DATABASE_URL. Never set this in a serverless deployment.
# USE_PGLITE=1
